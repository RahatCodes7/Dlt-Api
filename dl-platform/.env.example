# DLT API Platform environment variables
DLT_APP_NAME=DLT API Platform
DLT_APP_VERSION=1.0.0
DLT_DEBUG=true
DLT_SECRET_KEY=change-me-in-production-32-chars
DLT_API_V1_STR=/v1/dlt

# Database (SQLite for local dev; PostgreSQL on Render)
DLT_DATABASE_URL=sqlite+aiosqlite:///./dl_platform.db

# Redis (rate limiting / cache)
DLT_REDIS_URL=redis://localhost:6379/0

# Security
DLT_API_KEY_PREFIX=dl_live
DLT_API_KEY_LENGTH=32

# Download limits
DLT_DOWNLOAD_TIMEOUT_SECONDS=60
DLT_MAX_CONCURRENT_DOWNLOADS=10

# JWT
DLT_JWT_SECRET_KEY=change-me-jwt-secret-32-chars
DLT_JWT_ALGORITHM=HS256
DLT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DLT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Resend)
DLT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
DLT_RESEND_FROM_EMAIL=noreply@yourdomain.com
DLT_RESEND_FROM_NAME=DELETE

# Google OAuth
DLT_GOOGLE_CLIENT_ID=your-google-client-id
DLT_GOOGLE_CLIENT_SECRET=your-google-client-secret
DLT_GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Frontend URL (for email links)
DLT_FRONTEND_URL=http://localhost:3000
