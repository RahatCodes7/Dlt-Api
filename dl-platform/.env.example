# DLT API Platform environment variables
DLT_APP_NAME=DLT API Platform
DLT_APP_VERSION=1.0.0
DLT_DEBUG=true
DLT_SECRET_KEY=change-me-in-production-32-chars
DLT_API_V1_STR=/v1/dlt

# Database (SQLite for local dev; PostgreSQL on Render)
DLT_DATABASE_URL=sqlite+aiosqlite:///./dl_platform.db

# Redis (rate limiting / cache)
DLT_REDIS_URL=redis://localhost:6379/0

# Security
DLT_API_KEY_PREFIX=dl_live
DLT_API_KEY_LENGTH=32

# Download limits
DLT_DOWNLOAD_TIMEOUT_SECONDS=600
DLT_INFO_TIMEOUT_SECONDS=120
DLT_DOWNLOAD_ORPHAN_MAX_AGE_SECONDS=1800
DLT_MIN_FREE_DISK_MB=256
DLT_FILE_URL_TTL_SECONDS=300
DLT_MAX_CONCURRENT_DOWNLOADS=10

# JWT
DLT_JWT_SECRET_KEY=change-me-jwt-secret-32-chars
DLT_JWT_ALGORITHM=HS256
DLT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DLT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Resend)
DLT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
DLT_RESEND_FROM_EMAIL=noreply@yourdomain.com
DLT_RESEND_FROM_NAME=DELETE

# Google OAuth
The redirect URI must be on the FRONTEND origin (the frontend proxies /v1/*):
DLT_GOOGLE_CLIENT_ID=your-google-client-id
DLT_GOOGLE_CLIENT_SECRET=your-google-client-secret
DLT_GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
# Production example: https://dltapi.cc.cd/v1/auth/google/callback
# Add the exact URI to the Google Cloud OAuth client before testing.

# Frontend URL (for email links)
DLT_FRONTEND_URL=http://localhost:3000

# CORS (comma-separated). FRONTEND_URL is always allowed.
# Enter origins without a trailing slash, e.g. https://your-frontend.com
DLT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for extra origins (useful for preview deployments)
DLT_CORS_ORIGIN_REGEX=

# Auth cookies. Leave empty for defaults: SameSite=None + Secure in production,
# SameSite=Lax on http local dev. Override if the frontend is on the same site.
DLT_COOKIE_SAMESITE=
DLT_COOKIE_SECURE=

# Grant admin role to these emails on registration
DLT_ADMIN_EMAILS=

# Proxy behaviour: auto (direct then proxy), always (proxy first), off
DLT_PROXY_MODE=auto
DLT_PROXY_MAX_ATTEMPTS=3

# Optional JSON list of proxies to seed on first boot
# DLT_INITIAL_PROXIES=[{"type":"http","host":"1.2.3.4","port":8080,"user":"u","password":"p"}]
DLT_INITIAL_PROXIES=
